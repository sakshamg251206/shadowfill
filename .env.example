# Optional environment variables. Nothing in this project loads a .env file on
# its own: copy this to .env, fill in what you need, and export it with
#   set -a; source .env; set +a
# None of these is required to install, test, or run on the synthetic fixture.

# Databento API key, read only by the cost guard (scripts/databento_probe.py) to price a
# download before making it. Requires the optional extra: pip install -e ".[data]"
DATABENTO_API_KEY=

# Where the data-dependent tests look for vendor files (defaults shown).
SHADOWFILL_LOBSTER_DIR=data/lobster
SHADOWFILL_ITCH_DIR=data/itch
# Point the ITCH sample tests at one file instead of searching SHADOWFILL_ITCH_DIR.
# SHADOWFILL_ITCH_SAMPLE=data/itch/12302019.NASDAQ_ITCH50.gz
# Symbol checked by the ITCH-vs-Nasdaq consistency test.
SHADOWFILL_ITCH_SYMBOL=UN

# CI sets this to 1 so a build without the C++ engine fails instead of skipping
# the engine-equivalence tests.
# SHADOWFILL_REQUIRE_CORE=1
